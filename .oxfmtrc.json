{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["convex/_generated/**"],
  "indentWidth": 2,
  "singleQuote": true,
  "semi": false,
  "trailingCommas": "none",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css",
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true
  }
}
