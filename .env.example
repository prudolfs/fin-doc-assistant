# Convex / TanStack Start
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel AI Gateway (provider/model selected during Phase 0)
AI_GATEWAY_API_KEY=
AI_GATEWAY_CHAT_MODEL=google/gemini-2.5-flash-lite

# Initial document limits (values selected during Phase 0)
DOCUMENT_MAX_ACCEPTED_FILES=5
DOCUMENT_MAX_ACCEPTED_FILE_BYTES=10485760
DOCUMENT_MAX_PAGES=50

# Per-account safeguards
ACCOUNT_MAX_DOCUMENTS=100
ACCOUNT_MAX_CHATS=200
ACCOUNT_MAX_STORAGE_BYTES=104857600
DATA_RETENTION_DAYS=365
EXPORT_RETENTION_HOURS=24
ALERT_FAILURE_THRESHOLD=5

# Production auth/privacy controls
AUTH_ENVIRONMENT=development
# ZDR may require a paid AI Gateway tier. No-prompt-training is always enabled.
AI_GATEWAY_ZERO_DATA_RETENTION=false
